# Salin file ini menjadi .env lalu sesuaikan

# --- Pengembangan di laptop ---
DATABASE_URL="mysql://root:@localhost:3306/kayukita"
NEXTAUTH_URL="http://localhost:3000"
# Isi dengan teks acak panjang, contoh dibuat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-teks-acak-yang-panjang"
# "lokal" = foto disimpan di public/uploads. Jangan isi variabel ini di Vercel.
NEXT_PUBLIC_PENYIMPANAN="lokal"

# --- Vercel (isi di Settings > Environment Variables, bukan di file ini) ---
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb?sslaccept=accept_invalid_certs&connection_limit=5"
# NEXTAUTH_URL="https://nama-proyek.vercel.app"
# NEXTAUTH_SECRET="teks acak panjang"
# BLOB_READ_WRITE_TOKEN diisi otomatis saat Blob store dihubungkan ke proyek
